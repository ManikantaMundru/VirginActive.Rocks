{
  "info": {
    "_postman_id": "8b3f5d4d-4a89-4d80-a305-0e4f6fce9a23",
    "name": "VirginActive Rocks API",
    "description": "Postman collection for manually testing the VirginActive Rocks technical assessment API. Set `baseUrl` and `apiKey` in collection variables. The Create Rock request stores the returned Rock ID in `rockId` for later PATCH requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7073"
    },
    {
      "key": "apiKey",
      "value": "rocks-local-development-key"
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "rockId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Rocks",
      "item": [
        {
          "name": "Create Rock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Increase monthly membership revenue\",\n  \"category\": \"Revenue\",\n  \"dueDate\": \"2026-09-15\",\n  \"note\": \"Increase revenue by improving member retention\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('rockId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Rocks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks"
              ]
            }
          }
        },
        {
          "name": "Get Pending Rocks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks?status=Pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Pending"
                }
              ]
            }
          }
        },
        {
          "name": "Update Rock to Completed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks/{{rockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks",
                "{{rockId}}"
              ]
            },
            "description": "Run after Create Rock. Valid transition: Pending -> Completed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Transition - Completed to Missed",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Missed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks/{{rockId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks",
                "{{rockId}}"
              ]
            },
            "description": "Run after Update Rock to Completed. Expected: 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation Error - Empty Title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \" \",\n  \"category\": \"Other\",\n  \"dueDate\": \"2026-09-15\",\n  \"note\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks"
              ]
            },
            "description": "Expected: 400 Problem Details with a title validation error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Not Found - Unknown Rock",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks/00000000-0000-0000-0000-000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks",
                "00000000-0000-0000-0000-000000000001"
              ]
            },
            "description": "Expected: 404 Problem Details."
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Enriched Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/profile/enriched",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "profile",
                "enriched"
              ]
            },
            "description": "Returns JSONPlaceholder profile data combined with member Rocks. Member ID 1 is recommended for manual testing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Unauthorized - Missing API Key",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members/{{memberId}}/rocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members",
                "{{memberId}}",
                "rocks"
              ]
            },
            "description": "Expected: 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}